# ===========================================
# Demokrat -- Environment Variables
# ===========================================
# Copy this file to .env.local and fill in values

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# --- Meilisearch ---
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=your-meilisearch-key
NEXT_PUBLIC_MEILISEARCH_HOST=http://127.0.0.1:7700
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=your-search-key

# --- Mapbox ---
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token

# --- Sentry ---
SENTRY_DSN=https://your-dsn@sentry.io/123
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/123
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# --- Bundestag DIP API ---
DIP_API_KEY=your-dip-api-key

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-key

# --- Cron Secret ---
CRON_SECRET=your-cron-secret

# --- Supabase Webhook ---
SUPABASE_WEBHOOK_SECRET=your-webhook-secret

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
